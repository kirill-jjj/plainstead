    "H",            ID_FULL_HISTORY,        VIRTKEY, CONTROL, NOINVERT
    "2",            ID_GOTO_INV,            VIRTKEY, CONTROL, NOINVERT
    "1",            ID_GOTO_SCENE,          VIRTKEY, CONTROL, NOINVERT
    "3",            ID_GOTO_WAYS,           VIRTKEY, CONTROL, NOINVERT
    "6",            ID_LISTSND_DOWN,        VIRTKEY, CONTROL, NOINVERT
    "5",            ID_LISTSND_ON,          VIRTKEY, CONTROL, NOINVERT
    "7",            ID_LISTSND_UP,          VIRTKEY, CONTROL, NOINVERT
    "M",            ID_OPEN_MANAGER,        VIRTKEY, CONTROL, NOINVERT
    "R",            ID_RESTART_MENU,        VIRTKEY, CONTROL, NOINVERT
    VK_F5,          ID_UPDATE,              VIRTKEY, NOINVERT
    VK_OEM_MINUS,   ID_VOLUME_DOWN,         VIRTKEY, CONTROL, NOINVERT
    "0",            ID_VOLUME_ON,           VIRTKEY, CONTROL, NOINVERT
    VK_OEM_PLUS,    ID_VOLUME_UP,           VIRTKEY, CONTROL, NOINVERT
    "L",            ID_MENU_LOG,            VIRTKEY, CONTROL, ALT, NOINVERT
