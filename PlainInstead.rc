//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_PLAININSTEAD        ICON                    "res\\PlainInstead.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&Игра"
    BEGIN
        MENUITEM "&Запустить игру\t\tCtrl+M",     ID_OPEN_MANAGER
        MENUITEM "&Добавить игру в библиотеку\t\tCtrl+N", ID_ADD_GAME_TO_LIB
        MENUITEM "&Загрузить сохранение\tCtrl+O", ID_FILE_OPEN
        MENUITEM "Со&хранить игру\tCtrl+S",     ID_FILE_SAVE_GAME
        MENUITEM "Начать игру &заново\tCtrl+R", ID_RESTART_MENU
        MENUITEM SEPARATOR
        MENUITEM "&Сбросить все настройки",     ID_RESET_ALL_SETTINGS
        MENUITEM "В&ыход",                      ID_APP_EXIT
    END
    POPUP "&Настройки"
    BEGIN
        MENUITEM "На&стройки\tCtrl+T",          ID_ENTER_SETUP
        MENUITEM "&Поиск\tCTRL+F",              ID_FIND_TEXT
        MENUITEM "Поиск &далее\tF3",            ID_FIND_NEXT
        MENUITEM "Обновить текст\t\tF5",        ID_UPDATE
        MENUITEM "Перейти к списку &действий \t\tCTRL+1", ID_GOTO_SCENE
        MENUITEM "Перейти к списку &инвентаря\tCTRL+2", ID_GOTO_INV
        MENUITEM "Перейти к списку &путей\t CTRL+3", ID_GOTO_WAYS
        MENUITEM "Включить &логирование\tCTRL+ALT+L", ID_MENU_LOG
        MENUITEM "Добавить &комментарий в лог\tCTRL+ALT+C", ID_MENU_ADD_COMMENT
    END
    POPUP "&Справка"
    BEGIN
        MENUITEM "&О программе PlainInstead...",  ID_APP_ABOUT
    END
    POPUP "&Звук"
    BEGIN
        MENUITEM "Громче &музыки\tCTRL+=",      ID_VOLUME_UP
        MENUITEM "Громче &меньше\tCTRL+-",      ID_VOLUME_DOWN
        MENUITEM "&Выключить звук\tCTRL+0",     ID_VOLUME_ON, CHECKED
        MENUITEM "Звуки ин&вентаря громче\t\tCTRL+7", ID_LISTSND_UP
        MENUITEM "Звуки ин&вентаря тише\t\tCTRL+6", ID_LISTSND_DOWN
        MENUITEM "Звуки ин&вентаря вкл/выкл\t\tCTRL+5", ID_LISTSND_ON, CHECKED
    END
END


